{
  "name": "fieldbook",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:rls": "supabase test db",
    "test:e2e": "playwright test",
    "db:start": "supabase start -x vector,logflare,edge-runtime,imgproxy,supavisor",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local --schema public > src/lib/database.types.ts",
    "seed": "tsx scripts/seed.ts",
    "import:xlsx": "tsx scripts/import-xlsx.ts",
    "seed:episodes": "tsx scripts/seed-episodes.ts",
    "demo:setup": "pnpm seed && pnpm import:xlsx && pnpm seed:episodes",
    "simulate": "tsx scripts/simulate-rig.ts",
    "check:bundle": "tsx scripts/check-bundle-secrets.ts",
    "make-admin": "tsx scripts/make-admin.ts"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "date-fns": "^4.4.0",
    "geist": "^1.8.1",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.58.0",
    "next": "15.5.28",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "3.10.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.22.0",
    "sharp": "0.35.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "fflate": "^0.8.3",
    "supabase": "2.121.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@12.14.0"
}
