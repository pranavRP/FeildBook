# ---------------------------------------------------------------------------
# Public (shipped to the browser). Safe to expose.
# ---------------------------------------------------------------------------
# Supabase project URL, e.g. https://<project-ref>.supabase.co (local: http://127.0.0.1:54321)
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon / publishable key. Grants nothing on its own: RLS protects every table.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Neutral app name shown in the UI and <title>.
NEXT_PUBLIC_APP_NAME=Fieldbook

# ---------------------------------------------------------------------------
# Server-only secrets. Never prefix with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------
# Supabase service-role / secret key. Bypasses RLS: server code only.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Server settings
# ---------------------------------------------------------------------------
# Public base URL of the app (invite links, redirects).
SITE_URL=http://localhost:3000
# Timezone used for "today" and per-day charts.
APP_TIMEZONE=America/Los_Angeles
# Requests per minute per rig API key on /api/v1/*.
API_RATE_LIMIT_PER_MINUTE=60

# ---------------------------------------------------------------------------
# Scripts (import / seed / simulator)
# ---------------------------------------------------------------------------
# Replace real venue names/addresses with neutral ones on import ("Office Site A").
DEMO_ANONYMIZE=true
# Used by scripts/simulate-rig.ts
FIELDBOOK_URL=http://localhost:3000
FIELDBOOK_API_KEY=
